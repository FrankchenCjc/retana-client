{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "retana",
  "version": "0.1.0",
  "identifier": "com.retana.client",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "retana",
        "label": "main",
        "width": 900,
        "height": 680,
        "minWidth": 600,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "iconAsTemplate": true,
      "tooltip": "retana"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["resources/bridge.crt"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "26.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
